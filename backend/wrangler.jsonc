{
  "name": "agent-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-10",
  "kv_namespaces": [
    { "binding": "MODEL_CONFIG", "id": "bf9e5f2a3edf44b4bac57897c86131e2" }
  ],
  "r2_buckets": [
    { "binding": "FILES_BUCKET", "bucket_name": "agent-files" }
  ],
  "ai": { "binding": "AI" },
  "vars": {
    "AI_GATEWAY_URL": "https://gateway.ai.cloudflare.com/v1/c76e175997632f5475ae215526c1ff1e/ai-agentic-app"
  }
}

